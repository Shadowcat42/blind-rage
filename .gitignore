# Source-only repository: opt in new root paths explicitly.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSE-EXCEPTION.txt
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/AGENTS.md
!/bootstrap.ps1
!/build.ps1
!/package.ps1
!/install.ps1
!/sync_ini.ps1
!/config/
!/src/
!/tests/
!/docs/
!/scripts/
!/.clang-format
!/format.ps1
!/.github/
**/*.exe
**/*.dll
**/*.lib
**/*.pdb
**/*.obj
**/*.o
**/*.zip
**/*.iso
**/*.xex
**/*.xxx
**/*.upk
**/*.tfc
**/*.bin
**/*.pages
**/*.DAT
**/*.log
**/*.pyc
**/__pycache__/
**/.env*
**/userdata/
**/research/
**/vendor/
**/tools/
**/dist/
**/build/
**/artifacts/
